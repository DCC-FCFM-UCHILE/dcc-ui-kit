node_modules/

# package-lock.json SÍ se versiona: el CI usa `npm ci` y `cache: npm`,
# y ambos lo necesitan. Sin él el workflow falla antes de instalar nada.

# sistema
.DS_Store
Thumbs.db

# editores
.vscode/
.idea/
*.swp

# temporales
*.log
.cache/

# dist/ SÍ se versiona a propósito: es el producto publicable y el CI verifica
# que coincida con lo que produce `npm run build`. No lo agregues aquí.
